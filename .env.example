# BRICS Smart Health & Supply Chain Resilience Configuration
# Database Connection
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/brics_health

# JWT Authentication
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Server & CORS
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
DEBUG=false
